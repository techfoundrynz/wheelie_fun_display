import { Theme } from "theme.slint";

// Keep at most the incoming and outgoing pages. Opaque
// translation avoids allocating screen snapshots or blending two full pages.
export component PageDeck inherits Rectangle {
    in property <int> page;
    in property <bool> animations-enabled: true;
    in property <bool> swipe-enabled: false;
    callback page-requested(int);
    out property <int> active-page: 0;
    out property <int> previous-page: -1;
    out property <bool> animating: false;
    out property <int> direction: 1;
    out property <float> progress: self.edge ? self.phase : 1 - self.phase;
    out property <bool> swiping: false;
    out property <bool> dragging: false;
    out property <int> swipe-origin: 0;
    out property <length> swipe-offset: 0px;
    out property <bool> vertical-dragging: false;
    out property <length> vertical-offset: 0px;
    private property <int> gesture-axis: 0;
    private property <bool> swipe-committed: false;
    private property <duration> snap-duration: 250ms;
    private property <length> direction-extreme: 0px;
    private property <int> latest-direction: 0;
    private property <bool> resetting: false;
    private property <bool> ready: false;
    private property <bool> edge: false;
    private property <float> phase: 0;
    min-height: 0px;
    vertical-stretch: 1;
    clip: true;
    background: Theme.bg;
    animate phase {
        duration: root.animating && root.animations-enabled ? root.snap-duration : 0ms;
        easing: ease-out;
    }
    animate swipe-offset {
        duration: root.animating && !root.dragging && root.animations-enabled ? root.snap-duration : 0ms;
        easing: ease-out;
    }
    public function snap() {
        self.resetting = true;
        gestures.cancel();
        self.resetting = false;
        self.animating = false;
        self.dragging = false;
        self.swiping = false;
        self.vertical-dragging = false;
        self.gesture-axis = 0;
        self.swipe-offset = 0px;
        self.phase = self.edge ? 1 : 0;
        self.previous-page = -1;
        self.active-page = self.page;
    }
    function advance() {
        if self.swiping { return; }
        if !self.ready || !self.animations-enabled {
            self.snap();
        } else if !self.animating && self.page != self.active-page {
            self.previous-page = self.active-page;
            self.snap-duration = 250ms;
            self.direction = self.page > self.active-page ? 1 : -1;
            self.active-page = self.page;
            self.animating = true;
            self.edge = !self.edge;
            self.phase = self.edge ? 1 : 0;
        }
    }
    function drag(offset: length) {
        if self.animating || !self.swipe-enabled { return; }
        if !self.dragging {
            self.swipe-origin = self.active-page;
            self.latest-direction = 0;
            self.direction-extreme = 0px;
        }
        self.dragging = true;
        self.swiping = true;
        // Recognize edge gestures too, cancelling any pressed child button,
        // but never move outside the three primary tabs.
        self.swipe-offset = clamp(offset,
            self.swipe-origin < 2 ? -self.width : 0px,
            self.swipe-origin > 0 ? self.width : 0px);
        if offset > self.direction-extreme + 8px {
            self.latest-direction = 1;
            self.direction-extreme = offset;
        } else if offset < self.direction-extreme - 8px {
            self.latest-direction = -1;
            self.direction-extreme = offset;
        } else if (self.latest-direction > 0 && offset > self.direction-extreme) ||
            (self.latest-direction < 0 && offset < self.direction-extreme) {
            self.direction-extreme = offset;
        }
        if self.swipe-offset != 0px {
            self.direction = self.swipe-offset < 0px ? 1 : -1;
            self.previous-page = self.swipe-origin + self.direction;
        }
    }
    function end-drag(cancel: bool) {
        if self.resetting || !self.dragging { return; }
        self.dragging = false;
        if self.swipe-offset == 0px {
            self.snap();
            return;
        }
        let fraction = abs(self.swipe-offset / self.width);
        self.swipe-committed = !cancel && abs(self.swipe-offset) >= 40px &&
            ((self.swipe-offset < 0px && self.latest-direction < 0) ||
            (self.swipe-offset > 0px && self.latest-direction > 0));
        self.snap-duration = max(1ms, (self.swipe-committed ? 1 - fraction : fraction) * 250ms);
        self.animating = true;
        self.swipe-offset = self.swipe-committed ? -self.direction * self.width : 0px;
        if self.swipe-committed {
            self.page-requested(self.swipe-origin + self.direction);
        }
    }
    function move-gesture(dx: length, dy: length) {
        if self.gesture-axis == 0 {
            self.gesture-axis = abs(dx) > abs(dy) ? 1 : 2;
        }
        if self.gesture-axis == 1 {
            self.drag(dx);
        } else {
            self.vertical-dragging = true;
            self.vertical-offset = dy;
        }
    }
    function finish-gesture(cancel: bool) {
        if self.gesture-axis == 1 { self.end-drag(cancel); }
        self.vertical-dragging = false;
        self.gesture-axis = 0;
    }
    changed page => {
        if self.dragging { self.snap(); } else { self.advance(); }
    }
    changed animations-enabled => { self.snap(); }
    // A rotation/resize must not leave an outgoing page at obsolete dimensions.
    changed width => { self.snap(); }
    changed height => { self.snap(); }
    init => { self.snap(); self.ready = true; }
    Timer {
        interval: root.snap-duration;
        running: root.animating;
        triggered => {
            root.animating = false;
            if root.swiping {
                root.active-page = root.swipe-committed ? root.swipe-origin + root.direction : root.swipe-origin;
                root.swiping = false;
                root.swipe-offset = 0px;
            }
            root.previous-page = -1;
            // Programmatic navigation during a slide coalesces to the latest
            // requested page, without ever retaining a third page.
            root.advance();
        }
    }

    gestures := SwipeGestureHandler {
        width: 100%;
        height: 100%;
        enabled: root.swipe-enabled && !root.animating;
        handle-swipe-left: true;
        handle-swipe-right: true;
        handle-swipe-up: true;
        handle-swipe-down: true;
        moved => {
            if self.swiping {
                root.move-gesture(self.current-position.x - self.pressed-position.x,
                    self.current-position.y - self.pressed-position.y);
            }
        }
        swiped => {
            root.move-gesture(self.current-position.x - self.pressed-position.x,
                self.current-position.y - self.pressed-position.y);
            root.finish-gesture(false);
        }
        cancelled => { root.finish-gesture(true); }
        @children
    }
}

export component TransitionPage inherits Rectangle {
    in property <int> page-index;
    in property <int> active-page;
    in property <bool> animating;
    in property <int> direction;
    in property <float> progress;
    in property <bool> swiping;
    in property <int> swipe-origin;
    in property <length> swipe-offset;
    width: 100%;
    height: 100%;
    x: self.swiping ? self.swipe-offset + (self.page-index == self.swipe-origin ? 0px : self.direction * self.width) :
        !self.animating ? 0px : self.direction * self.width *
        (self.page-index == self.active-page ? 1 - self.progress : -self.progress);
    background: Theme.bg;
    @children
}
