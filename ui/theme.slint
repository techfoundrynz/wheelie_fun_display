// Wheelie app theme reference; see docs/wheelie-theming-guide.md.
// Typography: 500 body, 700 controls/section labels, 800 headings and values.
// Keep literal weights on text so the embedded font compiler includes each face.
export global Theme {
    out property <length> control-border: 2px;
    out property <color> bg: #000000;
    out property <color> surface: #1d1d1d;
    out property <color> raised: #2a2a2a;
    out property <color> sunken: #141414;
    out property <color> control: #444444;
    out property <color> track: #555555;
    out property <color> accent: #69d2df;
    out property <color> text: #ffffff;
    out property <color> secondary: #bbbbbb;
    out property <color> muted: #aaaaaa;
    out property <color> dim: #808080;
    out property <color> danger: #ff4444;
    out property <color> warning: #ffc300;
    out property <color> gauge: #ffd700;
    out property <color> eco: #198e13;
    out property <color> cruise: #0e77ac;
    out property <color> sport: #ac0e0e;
}
