import { Page } from "page.slint";
import { PageDeck, TransitionPage } from "page-transition.slint";
import { SwipeScroll } from "swipe-scroll.slint";
import { SettingsPage, InfoRow, SettingsRow } from "settings.slint";
import { Action, IconAction, Metric } from "controls.slint";
import { Keyboard } from "keyboard.slint";
import { PinPad } from "pin-pad.slint";
import { Theme } from "theme.slint";
import { Speedometer } from "speedometer.slint";
import { SafeArea } from "safe-area.slint";
import "fonts/Roboto.ttf";

export struct Peer { name: string, address: string, signal: string }
export struct WifiItem { ssid: string, detail: string }
export struct AboutItem { label: string, value: string }

export component Dashboard inherits Window {
    title: root.vehicle-brand;
    in property <length> initial-width: 410px;
    in property <length> initial-height: 502px;
    // Conservative 2.06-inch preview default; firmware sets this from its profile.
    in property <length> display-safe-inset: 32px;
    width: self.initial-width;
    height: self.initial-height;
    background: Theme.bg;
    default-font-family: "Roboto";
    default-font-size: 16px;
    default-font-weight: 500;

    in property <string> connection: "Disconnected";
    in property <bool> connected: false;
    in property <bool> link-present: false;
    in property <int> transport-kind;
    in property <bool> can-available;
    in property <bool> uart-available;
    in property <bool> can-change-transport: true;
    in property <string> controller-status;
    callback transport-requested(int);
    callback connect-wired();
    callback discover-controller();
    in property <bool> fresh: false;
    in property <bool> can-configure: false;
    in property <string> speed: "--";
    in property <float> speed-progress: 0;
    in property <string> battery: "--";
    in property <float> battery-level: 0;
    in property <string> voltage: "--";
    in property <string> power: "--";
    in property <string> mosfet: "--";
    in property <string> motor: "--";
    in property <string> pitch: "--";
    in property <bool> hot: false;
    in property <string> fault-text: "";
    out property <bool> header-alert: root.fresh && root.fault-text != "";
    out property <string> header-status: root.header-alert ? root.fault-text : root.connection;
    in property <[Peer]> peers;
    in-out property <bool> metric: true;
    in-out property <bool> celsius: true;
    in-out property <bool> ble-proxy-enabled: false;
    in property <string> ble-proxy-status;
    in property <string> proxy-name: "WB Disp";
    callback edit-proxy-name();
    in property <bool> pairing-open;
    in property <bool> pairing-failed;
    in property <bool> pairing-ready;
    in property <bool> pairing-permitted: true;
    in property <string> pairing-mask;
    callback pairing-type(int);
    callback pairing-backspace();
    callback pairing-submit();
    callback pairing-cancel();
    callback pairing-retry();
    in-out property <int> brightness: 70;
    in property <int> active-integration: 1;
    in property <string> vehicle-brand: "Wheelie Fun Bike";
    in property <bool> supports-presets: true;
    in property <bool> supports-limit: true;
    in property <bool> supports-lock: true;
    in-out property <int> integration-choice: -1;
    callback screen-lock();
    in property <bool> pin-configured;
    in property <bool> screen-locked;
    in property <bool> screen-asleep;
    in property <bool> pin-open;
    in property <bool> pin-ready: true;
    in property <bool> lock-retry-available;
    in property <string> pin-heading;
    in property <string> pin-mask;
    in property <string> pin-message;
    in property <string> bike-lock-status: "Set a PIN to enable bike locking.";
    in property <int> lock-timeout: 30;
    callback pin-setup();
    callback pin-remove();
    callback bike-lock();
    callback pin-digit(int);
    callback pin-backspace();
    callback pin-submit();
    callback pin-cancel();
    callback lock-retry();
    callback lock-timeout-changed(int);
    in-out property <int> page: 0;
    in property <bool> animations-enabled: true;
    out property <bool> transitioning: pages.animating;
    out property <int> displayed-page: pages.active-page;
    out property <int> outgoing-page: pages.previous-page;
    in-out property <int> draft-mode: 1;
    in-out property <int> draft-limit: 20;
    in property <string> feedback: "Changes are sent only when you tap Apply.";
    in property <bool> confirming: false;
    in property <string> confirm-text;
    callback connect-peer(int);
    callback forget-peer();
    callback apply-mode(int);
    callback apply-limit(int);
    callback confirm-change();
    callback cancel-change();
    callback preferences-changed();
    callback ble-proxy-changed(bool);
    in-out property <int> rotation: 0;
    callback orientation-requested(int);
    in property <string> device-label: "Waveshare AMOLED 2.06";
    in property <string> firmware-version: "--";
    in property <string> wifi-status: "Scan for networks";
    in property <string> wifi-saved;
    in property <bool> network-busy;
    in property <bool> wifi-connected;
    in property <[WifiItem]> wifi-networks;
    in property <string> release-version;
    in property <bool> update-available;
    in property <bool> updating;
    in property <bool> reboot-ready;
    in property <int> update-progress;
    in property <bool> can-maintain: true;
    in-out property <bool> ota-confirming: false;
    in property <bool> editing;
    in property <string> editor-heading;
    in property <string> editor-value;
    in property <string> editor-masked;
    in property <bool> editor-secret;
    in property <[AboutItem]> about-items;
    in-out property <bool> about-diagnostics: false;
    callback wifi-scan();
    callback wifi-select(int);
    callback wifi-manual();
    callback wifi-connect-saved();
    callback wifi-forget();
    callback editor-type(string);
    callback editor-backspace();
    callback editor-done();
    callback editor-cancel();
    callback update-check();
    callback update-install();
    callback update-cancel();
    callback update-reboot();

    changed rotation => { pages.snap(); }
    changed editing => { if self.editing { pages.snap(); } }
    changed pin-open => { if self.pin-open { pages.snap(); } }
    changed confirming => { if self.confirming { pages.snap(); } }
    changed ota-confirming => { if self.ota-confirming { pages.snap(); } }

    private property <bool> compact: self.height < 560px;
    private property <bool> landscape: self.width > self.height;
    private property <bool> short-landscape: self.width > self.height && self.height < 450px;
    private property <length> gutter: self.width < 380px ? 12px : 20px;
    private property <length> content-inset: max(self.gutter, self.display-safe-inset);

    SafeArea {
        width: root.width;
        height: root.height;
        safe-inset: root.display-safe-inset;
        minimum-padding: root.gutter;
        VerticalLayout {
            padding: 0px;
            spacing: root.compact ? 8px : 12px;
            HorizontalLayout {
                height: 48px;
                spacing: 12px;
                Rectangle {
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    height: 48px;
                    Rectangle {
                        x: 0px;
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: root.header-alert ? Theme.danger : root.fresh ? Theme.accent : root.connected ? Theme.warning : Theme.danger;
                    }

                    Text {
                        x: 20px;
                        width: max(0px, parent.width - self.x);
                        height: parent.height;
                        text: root.header-status;
                        color: root.header-alert ? Theme.danger : Theme.secondary;
                        font-size: 18px;
                        font-weight: 700;
                        wrap: word-wrap;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                IconAction {
                    icon: @image-url("assets/settings.svg");
                    label: "Settings";
                    selected: root.page >= 3;
                    activated => { root.page = 3; }
                }
            }

            pages := PageDeck {
                page: root.page;
                animations-enabled: root.animations-enabled;
                swipe-enabled: root.page >= 0 && root.page <= 2 && !root.confirming && !root.ota-confirming && !root.editing && !root.pin-open;
                page-requested(page) => { root.page = page; }
                if pages.active-page == 0 || pages.previous-page == 0: TransitionPage {
                    page-index: 0;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    if !root.landscape: VerticalLayout {
                        spacing: 10px;

                        Rectangle {
                            height: 35px;
                            background: Theme.track;
                            border-radius: 10px;
                            Rectangle {
                                x: 0;
                                width: parent.width * min(100, max(0, root.battery-level)) / 100;
                                background: Theme.accent;
                                border-radius: 10px;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: root.battery;
                                    color: #000000;
                                    font-size: 18px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.voltage;
                                    color: root.battery-level > 85 ? Theme.surface : Theme.text;
                                    font-size: 18px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            min-height: 0px;
                            vertical-stretch: 1;
                        }

                        Speedometer {
                            height: root.compact ? 166px : 231px;
                            value: root.speed;
                            live: root.fresh;
                            progress: root.speed-progress;
                            unit: root.metric ? "km/h" : "mph";
                        }

                        HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            Metric {
                                height: 60px;
                                label: "POWER";
                                value: root.power;
                            }

                            Metric {
                                height: 60px;
                                label: "PITCH";
                                value: root.pitch;
                            }
                        }

                        if !root.compact: HorizontalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            Metric {
                                height: 60px;
                                label: "CONTROLLER";
                                value: root.mosfet;
                                warning: root.hot;
                            }

                            Metric {
                                height: 60px;
                                label: "MOTOR";
                                value: root.motor;
                                warning: root.hot;
                            }
                        }
                    }
                    if root.landscape: HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            alignment: end;
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 1;
                            spacing: 12px;
                            Speedometer {
                                height: min(231px, max(110px, root.height - 161px - 2 * root.content-inset));
                                value: root.speed;
                                live: root.fresh;
                                progress: root.speed-progress;
                                unit: root.metric ? "km/h" : "mph";
                            }

                            Rectangle {
                                height: 35px;
                                background: Theme.track;
                                border-radius: 10px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * min(100, max(0, root.battery-level)) / 100;
                                    background: Theme.accent;
                                    border-radius: 10px;
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.battery;
                                        color: root.battery-level > 25 ? #000000 : Theme.text;
                                        font-size: 18px;
                                        font-weight: 800;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: root.voltage;
                                        color: root.battery-level > 85 ? Theme.surface : Theme.text;
                                        font-size: 18px;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            min-width: 0px;
                            preferred-width: 0px;
                            horizontal-stretch: 1;
                            spacing: 12px;
                            alignment: end;
                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 10px;
                                Metric {
                                    compact: root.short-landscape;
                                    height: root.short-landscape ? 64px : 76px;
                                    label: "POWER";
                                    value: root.power;
                                }

                                Metric {
                                    compact: root.short-landscape;
                                    height: root.short-landscape ? 64px : 76px;
                                    label: "PITCH";
                                    value: root.pitch;
                                }
                            }

                            HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 10px;
                                Metric {
                                    compact: root.short-landscape;
                                    height: root.short-landscape ? 64px : 76px;
                                    label: "ESC TEMP";
                                    value: root.mosfet;
                                    warning: root.hot;
                                }

                                Metric {
                                    compact: root.short-landscape;
                                    height: root.short-landscape ? 64px : 76px;
                                    label: "MOTOR";
                                    value: root.motor;
                                    warning: root.hot;
                                }
                            }
                        }
                    }
                }
                if pages.active-page == 1 || pages.previous-page == 1: TransitionPage {
                    page-index: 1;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    SwipeScroll {
                        scroll-active: pages.vertical-dragging;
                        drag-delta: pages.vertical-offset;
                        content-width: self.width;
                        VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: "RIDE TUNING";
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 800;
                            }

                            if !root.supports-presets && !root.supports-limit: Text {
                                text: "Ride presets and speed-limit tuning are not available for " + root.vehicle-brand + ". Use VESC Tool for vehicle configuration.";
                                color: Theme.secondary;
                                font-size: 16px;
                                wrap: word-wrap;
                            }

                            if root.supports-presets: VerticalLayout {
                                spacing: 12px;
                                Text {
                                    text: "Ride response";
                                    color: Theme.secondary;
                                    font-size: 14px;
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    for name[i] in ["Eco", "Cruise", "Sport"]: Action {
                                        label: name;
                                        selected: root.draft-mode == i;
                                        enabled: root.connected;
                                        border-color: !root.connected ? Theme.raised : i == 0 ? Theme.eco : i == 1 ? Theme.cruise : Theme.sport;
                                        activated => { root.draft-mode = i; }
                                    }
                                }

                                Action {
                                    label: "Apply ride response";
                                    enabled: root.connected && root.can-configure;
                                    activated => { root.apply-mode(root.draft-mode); }
                                }
                            }
                            if root.supports-limit: VerticalLayout {
                                spacing: 12px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Action {
                                        label: "-";
                                        width: 52px;
                                        enabled: root.connected && root.draft-limit > 5;
                                        activated => { root.draft-limit -= 1; }
                                    }

                                    Text {
                                        text: "Limit: " + (root.metric ? round(root.draft-limit * 1.609344) : root.draft-limit) + (root.metric ? " km/h" : " mph");
                                        color: Theme.text;
                                        font-size: 20px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    Action {
                                        label: "+";
                                        width: 52px;
                                        enabled: root.connected && root.draft-limit < 35;
                                        activated => { root.draft-limit += 1; }
                                    }
                                }

                                Action {
                                    label: "Apply speed limit";
                                    enabled: root.connected && root.can-configure;
                                    activated => { root.apply-limit(root.draft-limit); }
                                }
                            }
                            if root.supports-presets || root.supports-limit: Text {
                                text: !root.connected ? "Connect to your bike to adjust ride tuning." : root.can-configure ? root.feedback : "Stop the bike and wait for live WFB telemetry to apply changes.";
                                color: Theme.secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                if pages.active-page == 2 || pages.previous-page == 2: TransitionPage {
                    page-index: 2;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    SwipeScroll {
                        scroll-active: pages.vertical-dragging;
                        drag-delta: pages.vertical-offset;
                        content-width: self.width;
                        VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "YOUR BIKE";
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 800;
                            }

                            if root.controller-status != "": Text {
                                text: root.controller-status;
                                color: Theme.secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            if root.link-present: Action {
                                label: "Find main controller again";
                                activated => { root.discover-controller(); }
                            }
                            if !root.link-present && root.transport-kind != 0: Action {
                                label: root.transport-kind == 1 ? "Connect via CAN" : "Connect via UART";
                                activated => { root.connect-wired(); }
                            }

                            SettingsRow {
                                label: "Vehicle integration";
                                detail: root.integration-choice == -1 ? "Auto" : root.integration-choice == 1 ? "Wheelie Fun Bike" : root.integration-choice == 2 ? "wheel-e" : "VESC";
                                enabled: !root.link-present;
                                activated => { root.integration-choice = root.integration-choice == -1 ? 1 : root.integration-choice == 1 ? 2 : root.integration-choice == 2 ? 0 : -1; }
                            }

                            if root.link-present: Text {
                                text: "Disconnect the bike to choose another integration.";
                                color: Theme.secondary;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                            if root.pin-configured: Action {
                                label: "Lock screen";
                                activated => { root.screen-lock(); }
                            }

                            SettingsRow {
                                label: root.pin-configured ? "Change PIN" : "Set lock PIN";
                                activated => { root.pin-setup(); }
                            }

                            if root.pin-configured && root.supports-lock: Action {
                                label: "Lock bike and screen";
                                enabled: root.connected && root.can-configure;
                                activated => { root.bike-lock(); }
                            }
                            if root.pin-configured: SettingsRow {
                                label: "Locked screen timeout";
                                detail: root.lock-timeout + " s";
                                activated => { root.lock-timeout-changed(root.lock-timeout == 15 ? 30 : root.lock-timeout == 30 ? 60 : root.lock-timeout == 60 ? 120 : 15); }
                            }
                            if root.pin-configured: SettingsRow {
                                label: "Remove PIN";
                                activated => { root.pin-remove(); }
                            }
                            Text {
                                text: root.bike-lock-status;
                                color: Theme.secondary;
                                wrap: word-wrap;
                                font-size: 14px;
                            }

                            if root.link-present: Action {
                                label: root.transport-kind == 0 ? "Forget bike and scan" : "Disconnect bike";
                                activated => { root.forget-peer(); }
                            }
                            if !root.link-present && root.transport-kind == 0: Rectangle {
                                VerticalLayout {
                                    spacing: 8px;
                                    for peer[i] in root.peers: Rectangle {
                                        height: 72px;
                                        background: Theme.surface;
                                        border-radius: 12px;
                                        VerticalLayout {
                                            padding: 12px;
                                            Text {
                                                text: peer.name + "   " + peer.signal;
                                                color: Theme.text;
                                                font-size: 18px;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: peer.address;
                                                color: Theme.secondary;
                                                font-size: 14px;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.connect-peer(i); }
                                        }
                                    }
                                }
                            }
                            if !root.link-present && root.transport-kind == 0 && root.peers.length == 0: Text {
                                text: "Power on your bike. Nearby VESC Bluetooth devices will appear here.";
                                color: Theme.secondary;
                                wrap: word-wrap;
                                font-size: 16px;
                            }
                            if !root.link-present && root.transport-kind == 0: Action {
                                label: "Clear saved bike / scan again";
                                activated => { root.forget-peer(); }
                            }
                            Text {
                                text: root.transport-kind == 0 ? "Standard VESC Bluetooth UART" : root.transport-kind == 1 ? "VESC CAN packet transport" : "VESC serial UART";
                                color: Theme.secondary;
                                font-size: 14px;
                            }
                        }
                    }
                }
                if pages.active-page == 3 || pages.previous-page == 3: TransitionPage {
                    page-index: 3;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    SettingsPage {
                        metric: root.metric;
                        celsius: root.celsius;
                        rotation: root.rotation;
                        brightness: root.brightness;
                        transport-kind: root.transport-kind;
                        can-available: root.can-available;
                        uart-available: root.uart-available;
                        can-change-transport: root.can-change-transport;
                        select-transport(kind) => { root.transport-requested(kind); }
                        ble-proxy-enabled: root.ble-proxy-enabled;
                        ble-proxy-status: root.ble-proxy-status;
                        proxy-name: root.proxy-name;
                        edit-proxy-name => { root.edit-proxy-name(); }
                        toggle-proxy => { root.ble-proxy-enabled = !root.ble-proxy-enabled; root.ble-proxy-changed(root.ble-proxy-enabled); }
                        toggle-units => { root.metric = !root.metric; root.preferences-changed(); }
                        toggle-temperature => { root.celsius = !root.celsius; root.preferences-changed(); }
                        rotate => { root.orientation-requested(root.rotation == 270 ? 0 : root.rotation + 90); }
                        dim => { root.brightness -= 10; root.preferences-changed(); }
                        brighten => { root.brightness += 10; root.preferences-changed(); }
                        wifi => { root.page = 4; root.wifi-scan(); }
                        updates => { root.page = 5; }
                        about => { root.page = 6; }
                    }
                }
                if pages.active-page == 4 || pages.previous-page == 4: TransitionPage {
                    page-index: 4;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    Page {
                        title: "WI-FI";
                        Text {
                            text: root.wifi-status;
                            color: Theme.secondary;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Action {
                                label: "Scan";
                                enabled: !root.network-busy;
                                activated => { root.wifi-scan(); }
                            }

                            Action {
                                label: "Hidden SSID";
                                enabled: !root.network-busy;
                                activated => { root.wifi-manual(); }
                            }
                        }

                        if root.wifi-saved != "": Action {
                            label: "Connect: " + root.wifi-saved;
                            enabled: !root.network-busy;
                            activated => { root.wifi-connect-saved(); }
                        }
                        if root.wifi-saved != "": Action {
                            label: "Forget saved network";
                            enabled: !root.network-busy;
                            activated => { root.wifi-forget(); }
                        }
                        for wifi[i] in root.wifi-networks: Action {
                            label: wifi.ssid + " / " + wifi.detail;
                            enabled: !root.network-busy;
                            activated => { root.wifi-select(i); }
                        }
                    }
                }
                if pages.active-page == 5 || pages.previous-page == 5: TransitionPage {
                    page-index: 5;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    Page {
                        title: "FIRMWARE UPDATE";
                        Text {
                            text: "techfoundrynz/wheelie_fun_display\nInstalled: " + root.firmware-version;
                            color: Theme.secondary;
                            font-size: 14px;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.wifi-status;
                            color: Theme.text;
                            font-size: 16px;
                            wrap: word-wrap;
                        }

                        if !root.wifi-connected: Action {
                            label: "Connect to Wi-Fi";
                            activated => { root.page = 4; root.wifi-scan(); }
                        }
                        Action {
                            label: "Check GitHub Releases";
                            enabled: root.wifi-connected && !root.network-busy && !root.reboot-ready;
                            activated => { root.update-check(); }
                        }

                        if root.update-available && !root.reboot-ready: Action {
                            label: "Install " + root.release-version;
                            enabled: !root.network-busy && root.can-maintain;
                            activated => { root.ota-confirming = true; }
                        }
                        if root.updating: Text {
                            text: root.update-progress + "% downloaded";
                            color: Theme.accent;
                            font-size: 18px;
                        }
                        if root.updating: Action {
                            label: "Cancel update";
                            activated => { root.update-cancel(); }
                        }
                        if root.reboot-ready: Action {
                            label: "Restart into update";
                            enabled: root.can-maintain;
                            activated => { root.update-reboot(); }
                        }
                    }
                }
                if pages.active-page == 6 || pages.previous-page == 6: TransitionPage {
                    page-index: 6;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    Page {
                        title: "ABOUT WHEELIE FUN DISPLAY";
                        HorizontalLayout {
                            spacing: 8px;
                            Action {
                                label: "Version";
                                selected: !root.about-diagnostics;
                                activated => { root.about-diagnostics = false; }
                            }

                            Action {
                                label: "Diagnostics";
                                selected: root.about-diagnostics;
                                activated => { root.about-diagnostics = true; }
                            }
                        }

                        if !root.about-diagnostics: VerticalLayout {
                            spacing: 12px;

                            Text {
                                text: "Wheelie Fun Display " + root.firmware-version;
                                color: Theme.text;
                                font-size: 24px;
                                font-weight: 800;
                                wrap: word-wrap;
                            }

                            Text {
                                text: root.device-label + "\nESP-IDF / PlatformIO / Slint\nGPL-3.0-only\ntechfoundrynz/wheelie_fun_display";
                                color: Theme.secondary;
                                font-size: 16px;
                                wrap: word-wrap;
                            }

                            Action {
                                label: "Check for updates";
                                enabled: !root.network-busy;
                                activated => { root.page = 5; root.update-check(); }
                            }
                        }
                        if root.about-diagnostics: VerticalLayout {
                            spacing: 8px;
                            for item in root.about-items: InfoRow {
                                label: item.label;
                                value: item.value;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: 50px;
                spacing: 6px;
                for label[i] in ["Ride", "Tune", "Bike"]: Action {
                    label: label;
                    selected: root.page == i;
                    activated => { root.page = i; }
                }
            }
        }
    }
    // Swallow presses/releases while either page is moving. Modal controls
    // remain above this blocker and retain their existing safety interlocks.
    if root.transitioning: TouchArea {
        clicked => {}
    }
    if root.confirming: Rectangle {
        background: #000000b3;
        SafeArea {
            safe-inset: root.display-safe-inset;
            minimum-padding: 24px;
            VerticalLayout {
                padding: 0px;
                alignment: center;
                spacing: 16px;
                Text {
                    text: "APPLY TO BIKE?";
                    color: Theme.accent;
                    font-size: 24px;
                    font-weight: 800;
                }

                Text {
                    text: root.confirm-text;
                    color: Theme.text;
                    font-size: 18px;
                    wrap: word-wrap;
                }

                Text {
                    text: "This changes the live bike configuration. The bike must remain stopped.";
                    color: Theme.secondary;
                    wrap: word-wrap;
                    font-size: 16px;
                }

                Action {
                    label: "Apply now";
                    enabled: root.connected && root.can-configure;
                    selected: true;
                    activated => { root.confirm-change(); }
                }

                Action {
                    label: "Cancel";
                    activated => { root.cancel-change(); }
                }
            }
        }
    }
    if root.ota-confirming: Rectangle {
        background: Theme.bg;
        SafeArea {
            safe-inset: root.display-safe-inset;
            minimum-padding: 20px;
            VerticalLayout {
                padding: 0px;
                spacing: 12px;
                alignment: center;
                Text {
                    text: "INSTALL UPDATE?";
                    color: Theme.accent;
                    font-size: 24px;
                }

                Text {
                    text: "Bluetooth will disconnect during installation. Keep the display powered. Restart after verification to use the new firmware.";
                    color: Theme.text;
                    wrap: word-wrap;
                    font-size: 16px;
                }

                Action {
                    label: "Install now";
                    enabled: root.can-maintain && root.wifi-connected && !root.network-busy;
                    activated => { root.ota-confirming = false; root.update-install(); }
                }

                Action {
                    label: "Cancel";
                    activated => { root.ota-confirming = false; }
                }
            }
        }
    }
    if root.editing: Keyboard {
        safe-inset: root.display-safe-inset;
        heading: root.editor-heading;
        value: root.editor-value;
        masked: root.editor-masked;
        secret: root.editor-secret;
        typed(value) => { root.editor-type(value); }
        backspace => { root.editor-backspace(); }
        done => { root.editor-done(); }
        cancel => { root.editor-cancel(); }
    }
    if root.pin-open: PinPad {
        safe-inset: root.display-safe-inset;
        heading: root.pin-heading;
        masked: root.pin-mask;
        message: root.pin-message;
        ready: root.pin-ready;
        locked: root.screen-locked;
        retry-available: root.lock-retry-available;
        digit(value) => { root.pin-digit(value); }
        backspace => { root.pin-backspace(); }
        submit => { root.pin-submit(); }
        cancel => { root.pin-cancel(); }
        retry => { root.lock-retry(); }
    }
    if root.pairing-open && root.pairing-permitted: PinPad {
        safe-inset: root.display-safe-inset;
        heading: "BLUETOOTH PIN";
        masked: root.pairing-mask;
        message: root.pairing-failed ? "Pairing failed. Retry to enter the current Bluetooth PIN." : "Enter the six-digit PIN configured on your VESC Express.";
        ready: root.pairing-ready;
        show-keypad: !root.pairing-failed;
        locked: false;
        retry-available: root.pairing-failed;
        retry-label: "Retry pairing";
        digit(value) => { root.pairing-type(value); }
        backspace => { root.pairing-backspace(); }
        submit => { root.pairing-submit(); }
        cancel => { root.pairing-cancel(); }
        retry => { root.pairing-retry(); }
    }
    if root.screen-asleep: Rectangle {
        background: #000;
        TouchArea { }
    }
}
