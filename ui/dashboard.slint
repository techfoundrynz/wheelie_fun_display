import { Header } from "header.slint";
import { Navigation } from "navigation.slint";
import { UpdateConfirmation } from "dialogs/update-confirmation.slint";
import { ApplyConfirmation } from "dialogs/apply-confirmation.slint";
import { AboutPage } from "pages/about.slint";
import { UpdatesPage } from "pages/updates.slint";
import { WifiPage } from "pages/wifi.slint";
import { StatsPage } from "pages/stats.slint";
import { TunePage } from "pages/tune.slint";
import { RidePage } from "pages/ride.slint";
import { PageDeck, TransitionPage } from "page-transition.slint";
import { SettingsPage } from "pages/settings.slint";
import { Keyboard } from "keyboard.slint";
import { PinPad } from "pin-pad.slint";
import { Theme } from "theme.slint";
import { SafeArea } from "safe-area.slint";
import "fonts/Roboto.ttf";
import { Peer, WifiItem, AboutItem, StatItem } from "models.slint";
export { Peer, WifiItem, AboutItem, StatItem } from "models.slint";

export component Dashboard inherits Window {
    title: root.vehicle-brand;
    // Host sizing metadata; each runtime resizes its window explicitly.
    in property <length> initial-width: 410px;
    in property <length> initial-height: 502px;
    // Conservative 2.06-inch preview default; firmware sets this from its profile.
    in property <length> display-safe-inset-x: 32px;
    in property <length> display-safe-inset-y: 16px;
    background: Theme.bg;
    default-font-family: "Roboto";
    default-font-size: 16px;
    default-font-weight: 500;

    in property <string> connection: "Disconnected";
    in property <bool> connected: false;
    in property <bool> connection-pending: false;
    in property <bool> phone-connected: false;
    in property <int> bike-ble-signal: -1;
    in property <int> bike-ble-rssi;
    in property <bool> link-present: false;
    in property <int> transport-kind;
    in property <bool> can-available;
    in property <bool> uart-available;
    in property <bool> can-change-transport: true;
    in property <string> controller-status;
    callback transport-requested(int);
    callback connect-wired();
    callback discover-controller();
    in property <bool> fresh: false;
    in property <bool> data-stale: false;
    in property <bool> can-configure: false;
    in property <string> speed: "--";
    in property <float> speed-progress: 0;
    in property <string> battery: "--";
    in property <float> battery-level: 80;
    in property <string> voltage: "--";
    in property <string> trip: "--";
    in property <string> odometer: "--";
    in property <string> power: "--";
    in property <[StatItem]> vesc-stats;
    in property <[StatItem]> bms-stats;
    in property <[StatItem]> bms-cells;
    in property <[StatItem]> bms-temperatures;
    in property <string> bms-state: "No recent VESC BMS data.";
    in property <string> motor-current: "--";
    in property <string> battery-current: "--";
    in property <string> roll: "--";
    in property <string> mosfet: "--";
    in property <string> motor: "--";
    in property <string> pitch: "--";
    in property <bool> hot: false;
    in property <string> fault-text: "";
    out property <bool> header-alert: root.fresh && root.fault-text != "";
    out property <color> header-color: root.header-alert ? Theme.danger : root.connected && root.fresh && !root.data-stale ? Theme.success : root.connected || root.connection-pending ? Theme.warning : Theme.danger;
    // Connection health colours the dot; only a current fault or thermal alert colours the label.
    out property <color> header-text-color: root.header-alert ? Theme.danger : Theme.text;
    out property <string> header-status: root.header-alert ? root.fault-text : root.connection;
    in property <[Peer]> peers;
    in-out property <bool> metric: true;
    in-out property <bool> celsius: true;
    in-out property <bool> ble-proxy-enabled: false;
    in property <string> ble-proxy-status;
    in property <string> proxy-name: "WB Disp";
    in property <bool> proxy-name-locked: false;
    callback edit-proxy-name();
    in property <bool> pairing-open;
    in property <bool> pairing-failed;
    in property <bool> pairing-ready;
    in property <bool> pairing-permitted: true;
    in property <string> pairing-value;
    callback pairing-type(int);
    callback pairing-backspace();
    callback pairing-clear();
    callback pairing-submit();
    callback pairing-cancel();
    callback pairing-retry();
    in-out property <int> brightness: 70;
    in property <int> active-integration: 1;
    in property <string> vehicle-brand: "Wheelie Fun Bike";
    in property <bool> supports-presets: true;
    in property <bool> supports-limit: true;
    in property <bool> supports-lock: true;
    in-out property <int> integration-choice: -1;
    callback screen-lock();
    in property <bool> pin-configured;
    in property <bool> screen-locked;
    // The opaque locked entry screen does not need the covered page's item tree.
    private property <bool> show-page-content: !(root.screen-locked && root.pin-open);
    in property <bool> screen-asleep;
    in property <bool> pin-open;
    in property <bool> pin-pattern;
    in property <int> unlock-method;
    in property <string> proxy-pairing-code;
    callback unlock-method-requested(int);
    in property <bool> pin-ready: true;
    in property <bool> lock-retry-available;
    in property <string> pin-heading;
    in property <string> pin-value;
    in property <string> pin-message;
    in property <string> bike-lock-status: "Set a screen lock to enable bike locking.";
    in property <int> lock-timeout: 30;
    callback pin-setup();
    callback pin-remove();
    callback bike-lock();
    callback pin-digit(int);
    callback pin-backspace();
    callback pin-clear();
    callback pin-submit();
    callback pin-cancel();
    callback lock-retry();
    callback lock-timeout-changed(int);
    in-out property <int> page: 0;
    in property <bool> animations-enabled: true;
    out property <bool> transitioning: pages.animating;
    out property <int> displayed-page: pages.active-page;
    out property <int> outgoing-page: pages.previous-page;
    in-out property <int> draft-mode: 1;
    in-out property <int> draft-limit: 20;
    in property <string> feedback: "Changes are sent only when you tap Apply.";
    in property <bool> confirming: false;
    in property <string> confirm-text;
    callback connect-peer(int);
    callback forget-peer();
    callback apply-mode(int);
    callback apply-limit(int);
    callback confirm-change();
    callback cancel-change();
    callback preferences-changed();
    callback ble-proxy-changed(bool);
    in-out property <int> rotation: 0;
    callback orientation-requested(int);
    in property <string> device-label: "Waveshare AMOLED 2.06";
    in property <string> firmware-version: "--";
    in property <string> wifi-status: "Scan for networks";
    in property <string> wifi-saved;
    in property <bool> network-busy;
    in property <bool> wifi-connected;
    in property <[WifiItem]> wifi-networks;
    in property <string> release-version;
    in property <bool> update-available;
    in property <bool> updating;
    in property <bool> reboot-ready;
    in property <int> update-progress;
    in property <bool> can-maintain: true;
    in-out property <bool> ota-confirming: false;
    in property <bool> editing;
    in property <string> editor-heading;
    in property <string> editor-value;
    in property <string> editor-masked;
    in property <bool> editor-secret;
    in property <[AboutItem]> about-items;
    in-out property <bool> about-diagnostics: false;
    callback wifi-scan();
    callback wifi-select(int);
    callback wifi-manual();
    callback wifi-connect-saved();
    callback wifi-forget();
    callback editor-type(string);
    callback editor-backspace();
    callback editor-done();
    callback editor-cancel();
    callback update-check();
    callback update-install();
    callback update-cancel();
    callback update-reboot();

    changed rotation => { pages.snap(); }
    changed editing => { if self.editing { pages.snap(); } }
    changed pin-open => { if self.pin-open { pages.snap(); } }
    changed confirming => { if self.confirming { pages.snap(); } }
    changed ota-confirming => { if self.ota-confirming { pages.snap(); } }

    private property <bool> compact: self.height < 560px;
    private property <bool> landscape: self.width > self.height;
    private property <bool> short-landscape: self.width > self.height && self.height < 450px;
    private property <length> gutter: self.width < 380px ? 12px : 20px;

    SafeArea {
        width: root.width;
        height: root.height;
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        minimum-padding-x: root.gutter;
        minimum-padding-y: 12px;
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Header {
                status: root.header-status;
                status-color: root.header-color;
                status-text-color: root.header-text-color;
                phone-connected: root.phone-connected;
                bike-ble-signal: root.bike-ble-signal;
                bike-ble-rssi: root.bike-ble-rssi;
                settings-selected: root.page >= 3;
                animate-status: root.animations-enabled && !root.screen-asleep && !root.pin-open && !root.editing && !root.confirming && !root.ota-confirming;
                open-settings => { root.page = 3; }
            }

            Rectangle {
                height: root.compact ? 8px : 12px;
            }

            pages := PageDeck {
                page: root.page;
                animations-enabled: root.animations-enabled;
                swipe-enabled: root.page >= 0 && root.page <= 2 && !root.confirming && !root.ota-confirming && !root.editing && !root.pin-open;
                page-requested(page) => { root.page = page; }
                if root.show-page-content && (pages.active-page == 0 || pages.previous-page == 0): RidePage {
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    battery: root.battery;
                    battery-level: root.battery-level;
                    compact: root.compact;
                    fresh: root.fresh;
                    hot: root.hot;
                    landscape: root.landscape;
                    metric: root.metric;
                    mosfet: root.mosfet;
                    motor: root.motor;
                    pitch: root.pitch;
                    power: root.power;
                    short-landscape: root.short-landscape;
                    speed: root.speed;
                    speed-progress: root.speed-progress;
                    voltage: root.voltage;
                    trip: root.trip;
                    odometer: root.odometer;
                }
                if root.show-page-content && (pages.active-page == 1 || pages.previous-page == 1): StatsPage {
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    connected: root.connected;
                    fresh: root.fresh;
                    metric: root.metric;
                    drag-delta: pages.vertical-offset;
                    scroll-active: pages.vertical-dragging;
                    speed: root.speed;
                    power: root.power;
                    battery: root.battery;
                    voltage: root.voltage;
                    vesc-stats: root.vesc-stats;
                    bms-stats: root.bms-stats;
                    bms-cells: root.bms-cells;
                    bms-temperatures: root.bms-temperatures;
                    bms-state: root.bms-state;
                    motor-current: root.motor-current;
                    battery-current: root.battery-current;
                    pitch: root.pitch;
                    roll: root.roll;
                    mosfet: root.mosfet;
                    motor: root.motor;
                    trip: root.trip;
                    odometer: root.odometer;
                }
                if root.show-page-content && (pages.active-page == 2 || pages.previous-page == 2): TunePage {
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    apply-limit(arg0) => { root.apply-limit(arg0); }
                    apply-mode(arg0) => { root.apply-mode(arg0); }
                    can-configure: root.can-configure;
                    connected: root.connected;
                    integration-pending: !root.connected && root.integration-choice == -1;
                    draft-limit <=> root.draft-limit;
                    draft-mode <=> root.draft-mode;
                    drag-delta: pages.vertical-offset;
                    feedback: root.feedback;
                    metric: root.metric;
                    scroll-active: pages.vertical-dragging;
                    supports-limit: root.supports-limit;
                    supports-presets: root.supports-presets;
                    vehicle-brand: root.vehicle-brand;
                }
                if root.show-page-content && (pages.active-page == 3 || pages.previous-page == 3): TransitionPage {
                    page-index: 3;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    SettingsPage {
                        bike-lock() => { root.bike-lock(); }
                        bike-lock-status: root.bike-lock-status;
                        can-configure: root.can-configure;
                        connect-peer(arg0) => { root.connect-peer(arg0); }
                        connect-wired() => { root.connect-wired(); }
                        connected: root.connected;
                        controller-status: root.controller-status;
                        discover-controller() => { root.discover-controller(); }
                        forget-peer() => { root.forget-peer(); }
                        integration-choice <=> root.integration-choice;
                        link-present: root.link-present;
                        lock-timeout: root.lock-timeout;
                        lock-timeout-changed(arg0) => { root.lock-timeout-changed(arg0); }
                        peers: root.peers;
                        pin-configured: root.pin-configured;
                        proxy-pairing-code: root.proxy-pairing-code;
                        pin-remove() => { root.pin-remove(); }
                        pin-setup() => { root.pin-setup(); }
                        screen-lock() => { root.screen-lock(); }
                        supports-lock: root.supports-lock;
                        metric: root.metric;
                        celsius: root.celsius;
                        rotation: root.rotation;
                        brightness: root.brightness;
                        transport-kind: root.transport-kind;
                        can-available: root.can-available;
                        uart-available: root.uart-available;
                        can-change-transport: root.can-change-transport;
                        select-transport(kind) => { root.transport-requested(kind); }
                        ble-proxy-enabled: root.ble-proxy-enabled;
                        ble-proxy-status: root.ble-proxy-status;
                        proxy-name: root.proxy-name;
                        proxy-name-locked: root.proxy-name-locked;
                        edit-proxy-name => { root.edit-proxy-name(); }
                        toggle-proxy => { root.ble-proxy-enabled = !root.ble-proxy-enabled; root.ble-proxy-changed(root.ble-proxy-enabled); }
                        toggle-units => { root.metric = !root.metric; root.preferences-changed(); }
                        toggle-temperature => { root.celsius = !root.celsius; root.preferences-changed(); }
                        rotate => { root.orientation-requested(root.rotation == 270 ? 0 : root.rotation + 90); }
                        dim => { root.brightness -= 10; root.preferences-changed(); }
                        brighten => { root.brightness += 10; root.preferences-changed(); }
                        wifi => { root.page = 4; root.wifi-scan(); }
                        updates => { root.page = 5; }
                        about => { root.page = 6; }
                    }
                }
                if root.show-page-content && (pages.active-page == 4 || pages.previous-page == 4): WifiPage {
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    network-busy: root.network-busy;
                    wifi-connect-saved() => { root.wifi-connect-saved(); }
                    wifi-forget() => { root.wifi-forget(); }
                    wifi-manual() => { root.wifi-manual(); }
                    wifi-networks: root.wifi-networks;
                    wifi-saved: root.wifi-saved;
                    wifi-scan() => { root.wifi-scan(); }
                    wifi-select(arg0) => { root.wifi-select(arg0); }
                    wifi-status: root.wifi-status;
                }
                if root.show-page-content && (pages.active-page == 5 || pages.previous-page == 5): UpdatesPage {
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    can-maintain: root.can-maintain;
                    firmware-version: root.firmware-version;
                    network-busy: root.network-busy;
                    ota-confirming <=> root.ota-confirming;
                    page <=> root.page;
                    reboot-ready: root.reboot-ready;
                    release-version: root.release-version;
                    update-available: root.update-available;
                    update-cancel() => { root.update-cancel(); }
                    update-check() => { root.update-check(); }
                    update-progress: root.update-progress;
                    update-reboot() => { root.update-reboot(); }
                    updating: root.updating;
                    wifi-connected: root.wifi-connected;
                    wifi-scan() => { root.wifi-scan(); }
                    wifi-status: root.wifi-status;
                }
                if root.show-page-content && (pages.active-page == 6 || pages.previous-page == 6): AboutPage {
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    about-diagnostics <=> root.about-diagnostics;
                    about-items: root.about-items;
                    device-label: root.device-label;
                    firmware-version: root.firmware-version;
                    network-busy: root.network-busy;
                    page <=> root.page;
                    update-check() => { root.update-check(); }
                }
            }

            Rectangle {
                height: root.landscape ? 16px : root.compact ? 8px : 12px;
            }

            Navigation {
                page: root.page;
                page-requested(page) => { root.page = page; }
            }
        }
    }
    // Swallow presses/releases while either page is moving. Modal controls
    // remain above this blocker and retain their existing safety interlocks.
    if root.transitioning: TouchArea {
        clicked => {}
    }
    if root.confirming: ApplyConfirmation {
        can-configure: root.can-configure;
        cancel-change() => { root.cancel-change(); }
        confirm-change() => { root.confirm-change(); }
        confirm-text: root.confirm-text;
        connected: root.connected;
        display-safe-inset-x: root.display-safe-inset-x;
        display-safe-inset-y: root.display-safe-inset-y;
    }
    if root.ota-confirming: UpdateConfirmation {
        can-maintain: root.can-maintain;
        display-safe-inset-x: root.display-safe-inset-x;
        display-safe-inset-y: root.display-safe-inset-y;
        network-busy: root.network-busy;
        ota-confirming <=> root.ota-confirming;
        update-install() => { root.update-install(); }
        wifi-connected: root.wifi-connected;
    }
    if root.editing: Keyboard {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        heading: root.editor-heading;
        value: root.editor-value;
        masked: root.editor-masked;
        secret: root.editor-secret;
        typed(value) => { root.editor-type(value); }
        backspace => { root.editor-backspace(); }
        done => { root.editor-done(); }
        cancel => { root.editor-cancel(); }
    }
    if root.pin-open: PinPad {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        heading: root.pin-heading;
        value: root.pin-value;
        pattern: root.pin-pattern;
        mode-requested(pattern) => { root.unlock-method-requested(pattern ? 1 : 0); }
        message: root.pin-message;
        ready: root.pin-ready;
        locked: root.screen-locked;
        retry-available: root.lock-retry-available;
        digit(value) => { root.pin-digit(value); }
        backspace => { root.pin-backspace(); }
        clear => { root.pin-clear(); }
        submit => { root.pin-submit(); }
        cancel => { root.pin-cancel(); }
        retry => { root.lock-retry(); }
    }
    if root.pairing-open && root.pairing-permitted: PinPad {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        heading: "BLUETOOTH PIN";
        value: root.pairing-value;
        pattern: false;
        allow-mode-change: false;
        auto-submit: false;
        min-digits: 1;
        message: root.pairing-failed ? "Pairing failed. Retry to enter the current Bluetooth PIN." : "Enter the numeric passkey configured on your VESC Express, then Submit.";
        ready: root.pairing-ready;
        show-keypad: !root.pairing-failed;
        locked: false;
        retry-available: root.pairing-failed;
        retry-label: "Retry pairing";
        digit(value) => { root.pairing-type(value); }
        backspace => { root.pairing-backspace(); }
        clear => { root.pairing-clear(); }
        submit => { root.pairing-submit(); }
        cancel => { root.pairing-cancel(); }
        retry => { root.pairing-retry(); }
    }
    if root.screen-asleep: Rectangle {
        background: #000;
        TouchArea { }
    }
}
