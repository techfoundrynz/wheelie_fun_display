import { Header } from "header.slint";
import { AutoHideFooter } from "navigation.slint";
import { UpdateConfirmation } from "dialogs/update-confirmation.slint";
import { UpdateProgress } from "dialogs/update-progress.slint";
import { ApplyConfirmation } from "dialogs/apply-confirmation.slint";
import { TuningEditor } from "dialogs/tuning-editor.slint";
import { AboutPage } from "pages/about.slint";
import { UpdatesPage } from "pages/updates.slint";
import { WifiPage } from "pages/wifi.slint";
import { StatsPage } from "pages/stats.slint";
import { TunePage } from "pages/tune.slint";
import { RidePage } from "pages/ride.slint";
import { PageDeck, TransitionPage } from "page-transition.slint";
import { SettingsPage } from "pages/settings.slint";
import { Keyboard } from "keyboard.slint";
import { PinPad } from "pin-pad.slint";
import { Theme } from "theme.slint";
import { SafeArea } from "safe-area.slint";
import { HardwareCapabilities } from "hardware.slint";
import "fonts/Roboto.ttf";
import { Peer, WifiItem, AboutItem, StatItem, TuneField, FooterVisibility } from "models.slint";
export { Peer, WifiItem, AboutItem, StatItem, TuneField, FooterVisibility } from "models.slint";

export component Dashboard inherits Window {
    title: root.vehicle-brand;
    // Host sizing metadata; each runtime resizes its window explicitly.
    in property <length> initial-width: 410px;
    in property <length> initial-height: 502px;
    // Conservative 2.06-inch preview default; firmware sets this from its profile.
    in property <length> display-safe-inset-x: 32px;
    in property <length> display-safe-inset-y: 16px;
    background: Theme.bg;
    default-font-family: "Roboto";
    default-font-size: 16px;
    default-font-weight: 500;

    in property <string> connection: "Disconnected";
    in property <bool> connected: false;
    in property <bool> connection-pending: false;
    in property <bool> phone-connected: false;
    in property <int> bike-ble-signal: -1;
    in property <int> bike-ble-rssi;
    in property <bool> link-present: false;
    in property <int> transport-kind;
    in property <bool> can-available;
    in property <bool> uart-available;
    in property <bool> can-change-transport: true;
    in property <string> controller-status;
    callback transport-requested(int);
    callback connect-wired();
    callback discover-controller();
    in property <bool> fresh: false;
    in property <bool> data-stale: false;
    in property <bool> can-configure: false;
    in property <string> speed: "--";
    in property <float> speed-progress: 0;
    in property <string> battery: "--";
    in property <float> battery-level: 80;
    in property <string> voltage: "--";
    in property <string> trip: "--";
    in property <string> odometer: "--";
    in property <string> power: "--";
    in property <[StatItem]> vesc-stats;
    in property <[StatItem]> bms-stats;
    in property <[StatItem]> bms-cells;
    in property <[StatItem]> bms-temperatures;
    in property <string> bms-state: "No recent VESC BMS data.";
    in property <string> motor-current: "--";
    in property <string> battery-current: "--";
    in property <string> roll: "--";
    in property <string> mosfet: "--";
    in property <string> motor: "--";
    in property <string> pitch: "--";
    in property <bool> hot: false;
    in property <string> fault-text: "";
    out property <bool> header-alert: root.fresh && root.fault-text != "";
    out property <color> header-color: root.header-alert ? Theme.danger : root.connected && root.fresh && !root.data-stale ? Theme.success : root.connected || root.connection-pending ? Theme.warning : Theme.danger;
    // Connection health colours the dot; only a current fault or thermal alert colours the label.
    out property <color> header-text-color: root.header-alert ? Theme.danger : Theme.text;
    out property <string> header-status: root.header-alert ? root.fault-text : root.connection;
    in property <[Peer]> peers;
    in-out property <bool> metric: true;
    in-out property <bool> celsius: true;
    in-out property <bool> ble-proxy-enabled: false;
    in property <string> ble-proxy-status;
    in property <string> proxy-name: "WB Disp";
    in property <bool> proxy-name-locked: false;
    callback edit-proxy-name();
    in property <bool> pairing-open;
    in property <bool> pairing-failed;
    in property <bool> pairing-ready;
    in property <bool> pairing-permitted: true;
    in property <string> pairing-value;
    callback pairing-type(int);
    callback pairing-backspace();
    callback pairing-clear();
    callback pairing-submit();
    callback pairing-cancel();
    callback pairing-retry();
    in-out property <int> brightness: 70;
    in-out property <FooterVisibility> footer-visibility: FooterVisibility.show;
    out property <bool> footer-hidden: footer.hidden;
    // Observe contacts before pointer dispatch; reveal only after release dispatch.
    public function screen-contact(down: bool) { footer.contact(down); }
    in property <int> active-integration: 1;
    in property <string> vehicle-brand: "Wheelie Fun Bike";
    in property <bool> supports-presets: true;
    in property <bool> supports-tuning: true;
    in property <bool> supports-limit: true;
    in property <bool> supports-lock: true;
    in-out property <int> integration-choice: -1;
    callback screen-lock();
    in property <bool> pin-configured;
    in property <bool> screen-locked;
    // The opaque locked entry screen does not need the covered page's item tree.
    private property <bool> show-page-content: !(root.screen-locked && root.pin-open);
    in property <bool> screen-asleep;
    in property <bool> pin-open;
    in property <bool> pin-pattern;
    in property <int> unlock-method;
    in property <string> proxy-pairing-code;
    callback unlock-method-requested(int);
    in property <bool> pin-ready: true;
    in property <bool> lock-retry-available;
    in property <string> pin-heading;
    in property <string> pin-value;
    in property <string> pin-message;
    in property <string> bike-lock-status: "Set a screen lock to enable bike locking.";
    in property <int> lock-timeout: 30;
    callback pin-setup();
    callback pin-remove();
    callback bike-lock();
    callback pin-digit(int);
    callback pin-backspace();
    callback pin-clear();
    callback pin-submit();
    callback pin-cancel();
    callback lock-retry();
    callback lock-timeout-changed(int);
    in-out property <int> page: 0;
    private property <int> last-main-page: 0;
    in property <bool> animations-enabled: true;
    out property <bool> transitioning: pages.animating;
    out property <int> displayed-page: pages.active-page;
    out property <int> outgoing-page: pages.previous-page;
    out property <bool> page-input-allowed: root.show-page-content && !root.screen-asleep && !root.screen-locked && !root.pin-open && !root.editing && !root.pairing-open && !root.confirming && !root.ota-confirming && !root.tuning-editor-open && !root.update-modal-open;
    out property <length> page-viewport-x: safe-area.x + safe-area.content-inset-x + body.x + pages.x - pages.horizontal-inset;
    out property <length> page-viewport-y: safe-area.y + safe-area.content-inset-y + body.y + pages.y;
    out property <length> page-viewport-width: pages.slide-width;
    out property <length> page-viewport-height: pages.height;
    in property <int> native-capture-page: -1;
    out property <bool> native-page-snapshots: HardwareCapabilities.page-snapshots;
    out property <bool> native-page-content-active: HardwareCapabilities.page-snapshots && root.show-page-content;
    out property <bool> native-slides-allowed: HardwareCapabilities.page-snapshots && self.page-input-allowed;
    out property <bool> native-slide-active: self.native-slides-allowed && (pages.animating || pages.swiping);
    out property <int> native-slide-incoming: HardwareCapabilities.page-snapshots ? (pages.swiping ? pages.previous-page : pages.active-page) : -1;
    out property <int> native-slide-outgoing: HardwareCapabilities.page-snapshots ? (pages.swiping ? pages.swipe-origin : pages.previous-page) : -1;
    out property <float> native-slide-progress: HardwareCapabilities.page-snapshots ? (pages.swiping ? abs(pages.swipe-offset) / max(1px, pages.slide-width) : pages.progress) : 0;
    out property <int> native-slide-direction: HardwareCapabilities.page-snapshots ? pages.direction : 1;
    out property <length> native-page-x: HardwareCapabilities.page-snapshots ? self.page-viewport-x : 0px;
    out property <length> native-page-y: HardwareCapabilities.page-snapshots ? self.page-viewport-y : 0px;
    out property <length> native-page-width: HardwareCapabilities.page-snapshots ? self.page-viewport-width : 0px;
    out property <length> native-page-height: HardwareCapabilities.page-snapshots ? self.page-viewport-height : 0px;
    in-out property <int> draft-mode: -1;
    in property <bool> tuning-ready: false;
    in property <[string]> tuning-presets: ["Eco", "Cruise", "Sport"];
    in property <[string]> tuning-preset-descriptions: [
        "Eco: 90 A motor limit with gentler response.",
        "Cruise: 150 A motor limit with smoother throttle response.",
        "Sport: 150 A motor limit with faster throttle response."
    ];
    in property <[string]> tuning-sections: ["Response", "Button", "Throttle", "Horn", "Advanced"];
    in property <bool> tuning-busy;
    in property <bool> tuning-dirty;
    in property <string> tuning-status;
    in property <string> tuning-saved-response: "Not read from bike";
    in property <string> tuning-saved-limit: "Not read from bike";
    in property <int> tuning-limit-min: 5;
    in property <int> tuning-limit-max: 35;
    in property <bool> tuning-unlimited: false;
    in property <[TuneField]> tuning-fields;
    in-out property <int> tuning-section;
    callback tuning-refresh();
    callback tuning-adjust(int, int);
    callback tuning-set(int, float);
    private property <int> tuning-editor-index: -1;
    out property <bool> tuning-editor-open: root.tuning-editor-index != -1;
    callback tuning-edit(int);
    tuning-edit(index) => {
        if index == -1 { root.tuning-editor-index = -1; return; }
        if root.connected && root.tuning-ready && !root.tuning-busy &&
            ((index == -2 && root.supports-limit) || (index >= 0 && index < root.tuning-fields.length && !root.tuning-fields[index].read-only)) {
            root.tuning-editor-index = index;
            pages.snap();
        }
    }
    private property <TuneField> limit-editor-field: {
        id: -1,
        label: "Speed limit",
        value: root.draft-limit == 0 ? "No limit" : (root.metric ? round(root.draft-limit * 1.609344) : root.draft-limit) + (root.metric ? " km/h" : " mph"),
        saved: root.tuning-saved-limit,
        can-decrease: root.draft-limit == 0 || root.draft-limit > root.tuning-limit-min,
        can-increase: root.draft-limit != 0 && (root.draft-limit < root.tuning-limit-max || root.tuning-unlimited),
        changed: false,
        kind: 3,
        minimum: 0,
        maximum: root.tuning-limit-max - root.tuning-limit-min + (root.tuning-unlimited ? 1 : 0),
        position: root.draft-limit == 0 ? root.tuning-limit-max - root.tuning-limit-min + 1 : root.draft-limit - root.tuning-limit-min,
        step: 1,
        default-position: 20 - root.tuning-limit-min,
        has-default: root.tuning-limit-min <= 20 && root.tuning-limit-max >= 20,
        read-only: false,
        read-only-reason: "",
        off-grid: false,
        tick-every: 5,
        options: []
    };
    function edit-limit-position(value: float) {
        root.draft-limit = root.tuning-unlimited && round(value) > root.tuning-limit-max - root.tuning-limit-min ? 0 : round(value) + root.tuning-limit-min;
    }
    callback tuning-save();
    callback tuning-reset();
    callback tuning-section-requested(int);
    in-out property <int> draft-limit: 20;
    in property <string> feedback: "Changes are sent only when you tap Apply.";
    in property <bool> confirming: false;
    in property <string> confirm-text;
    callback connect-peer(int);
    callback forget-peer();
    callback apply-mode(int);
    callback apply-limit(int);
    callback confirm-change();
    callback cancel-change();
    callback preferences-changed();
    callback ble-proxy-changed(bool);
    in-out property <int> rotation: 0;
    callback orientation-requested(int);
    in property <string> device-label: "Waveshare AMOLED 2.06";
    in property <string> firmware-version: "--";
    in property <string> wifi-status: "Scan for networks";
    in property <string> wifi-saved;
    in property <bool> network-busy;
    in property <bool> wifi-connected;
    in property <[WifiItem]> wifi-networks;
    in property <string> release-version;
    in property <bool> update-available;
    in property <bool> updating;
    in property <bool> update-cancellable: true;
    in property <bool> reboot-ready;
    in property <int> update-progress;
    in property <bool> can-maintain: true;
    in property <bool> vesc-update-mode;
    in property <bool> vesc-update-active;
    in property <bool> vesc-update-cancellable: true;
    in property <string> vesc-update-transport: "BLE";
    in property <int> vesc-update-progress;
    in property <string> vesc-update-status: "Ready for VESC Tool";
    callback vesc-update-mode-requested(bool);
    callback vesc-update-cancel();
    in-out property <bool> ota-confirming: false;
    private property <bool> update-result-open;
    private property <bool> update-dialog-vesc;
    out property <bool> update-modal-open: root.updating || root.reboot-ready || root.vesc-update-active || root.update-result-open;
    changed updating => { if self.updating { self.update-dialog-vesc = false; self.update-result-open = true; self.ota-confirming = false; pages.snap(); } }
    changed vesc-update-active => { if self.vesc-update-active { self.update-dialog-vesc = true; self.update-result-open = true; self.ota-confirming = false; pages.snap(); } }
    changed reboot-ready => { if self.reboot-ready { self.update-dialog-vesc = false; self.update-result-open = true; pages.snap(); } }
    in property <bool> editing;
    in property <string> editor-heading;
    in property <string> editor-value;
    in property <string> editor-masked;
    in property <bool> editor-secret;
    in property <[AboutItem]> about-items;
    in-out property <bool> about-diagnostics: false;
    callback wifi-scan();
    callback wifi-select(int);
    callback wifi-manual();
    callback wifi-connect-saved();
    callback wifi-forget();
    callback editor-type(string);
    callback editor-backspace();
    callback editor-done();
    callback editor-cancel();
    callback update-check();
    callback update-install();
    callback update-cancel();
    callback update-reboot();

    changed rotation => { root.tuning-editor-index = -1; pages.snap(); }
    changed page => {
        root.tuning-editor-index = -1;
        if root.page >= 0 && root.page <= 2 { root.last-main-page = root.page; }
    }
    changed tuning-ready => { if !self.tuning-ready { self.tuning-editor-index = -1; } }
    changed editing => { if self.editing { pages.snap(); } }
    changed pin-open => { if self.pin-open { root.tuning-editor-index = -1; pages.snap(); } }
    changed confirming => { if self.confirming { root.tuning-editor-index = -1; pages.snap(); } }
    changed ota-confirming => { if self.ota-confirming { pages.snap(); } }

    private property <bool> compact: self.height < 560px;
    private property <bool> landscape: self.width > self.height;
    private property <bool> short-landscape: self.width > self.height && self.height < 450px;
    private property <length> gutter: self.width < 380px ? 12px : 20px;

    if HardwareCapabilities.page-snapshots && root.native-capture-page == -2: Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.bg;
    }
    safe-area := SafeArea {
        width: root.width;
        height: root.height;
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        minimum-padding-x: root.gutter;
        minimum-padding-y: 12px;
        body := VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Header {
                status: root.header-status;
                status-color: root.header-color;
                status-text-color: root.header-text-color;
                phone-connected: root.phone-connected;
                bike-ble-signal: root.bike-ble-signal;
                bike-ble-rssi: root.bike-ble-rssi;
                settings-selected: root.page >= 3;
                show-lock: root.page >= 3 && root.pin-configured && root.supports-lock && root.page-input-allowed;
                lock-enabled: root.connected && root.can-configure;
                animate-status: root.animations-enabled && !root.screen-asleep && !root.pin-open && !root.editing && !root.confirming && !root.ota-confirming && !root.update-modal-open;
                open-settings => {
                    if root.page == 3 {
                        root.page = root.last-main-page;
                    } else {
                        if root.page >= 0 && root.page <= 2 { root.last-main-page = root.page; }
                        root.page = 3;
                    }
                }
                lock-bike => { root.bike-lock(); }
            }

            Rectangle {
                height: root.compact ? 8px : 12px;
            }

            pages := PageDeck {
                horizontal-inset: safe-area.content-inset-x;
                page: root.page;
                animations-enabled: root.animations-enabled;
                swipe-enabled: root.page >= 0 && root.page <= 2 && !root.confirming && !root.ota-confirming && !root.editing && !root.pin-open && !root.tuning-editor-open && !root.update-modal-open;
                page-requested(page) => { root.page = page; }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 0 || pages.previous-page == 0): RidePage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 0 || pages.previous-page == 0;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    battery: root.battery;
                    battery-level: root.battery-level;
                    compact: root.compact;
                    fresh: root.fresh;
                    hot: root.hot;
                    landscape: root.landscape;
                    metric: root.metric;
                    mosfet: root.mosfet;
                    motor: root.motor;
                    pitch: root.pitch;
                    power: root.power;
                    short-landscape: root.short-landscape;
                    speed: root.speed;
                    speed-progress: root.speed-progress;
                    voltage: root.voltage;
                    trip: root.trip;
                    odometer: root.odometer;
                }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 1 || pages.previous-page == 1): StatsPage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 1 || pages.previous-page == 1;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    connected: root.connected;
                    fresh: root.fresh;
                    metric: root.metric;
                    drag-delta: pages.vertical-offset;
                    drag-cancelled: pages.vertical-cancelled;
                    input-sequence: pages.input-sequence;
                    input-time: pages.input-time;
                    scroll-active: pages.vertical-dragging;
                    speed: root.speed;
                    power: root.power;
                    battery: root.battery;
                    voltage: root.voltage;
                    vesc-stats: root.vesc-stats;
                    bms-stats: root.bms-stats;
                    bms-cells: root.bms-cells;
                    bms-temperatures: root.bms-temperatures;
                    bms-state: root.bms-state;
                    motor-current: root.motor-current;
                    battery-current: root.battery-current;
                    pitch: root.pitch;
                    roll: root.roll;
                    mosfet: root.mosfet;
                    motor: root.motor;
                    trip: root.trip;
                    odometer: root.odometer;
                }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 2 || pages.previous-page == 2): TunePage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 2 || pages.previous-page == 2;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    apply-limit(arg0) => { root.apply-limit(arg0); }
                    apply-mode(arg0) => { root.apply-mode(arg0); }
                    can-configure: root.can-configure;
                    connected: root.connected;
                    integration-pending: !root.connected && root.integration-choice == -1;
                    draft-limit <=> root.draft-limit;
                    draft-mode <=> root.draft-mode;
                    drag-delta: pages.vertical-offset;
                    drag-cancelled: pages.vertical-cancelled;
                    input-sequence: pages.input-sequence;
                    input-time: pages.input-time;
                    feedback: root.feedback;
                    metric: root.metric;
                    scroll-active: pages.vertical-dragging;
                    supports-limit: root.supports-limit;
                    supports-presets: root.supports-presets;
                    vehicle-brand: root.vehicle-brand;
                    supports-tuning: root.supports-tuning;
                    tuning-presets: root.tuning-presets;
                    tuning-preset-descriptions: root.tuning-preset-descriptions;
                    tuning-sections: root.tuning-sections;
                    tuning-ready: root.tuning-ready;
                    tuning-busy: root.tuning-busy;
                    tuning-dirty: root.tuning-dirty;
                    tuning-status: root.tuning-status;
                    tuning-saved-response: root.tuning-saved-response;
                    tuning-saved-limit: root.tuning-saved-limit;
                    tuning-limit-min: root.tuning-limit-min;
                    tuning-limit-max: root.tuning-limit-max;
                    tuning-unlimited: root.tuning-unlimited;
                    tuning-fields: root.tuning-fields;
                    tuning-section <=> root.tuning-section;
                    tuning-refresh => { root.tuning-refresh(); }
                    tuning-adjust(id, delta) => { root.tuning-adjust(id, delta); }
                    tuning-set(id, value) => { root.tuning-set(id, value); }
                    tuning-edit(index) => { root.tuning-edit(index); }
                    tuning-save => { root.tuning-save(); }
                    tuning-reset => { root.tuning-reset(); }
                    tuning-section-requested(section) => { root.tuning-section-requested(section); }
                }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 3 || pages.previous-page == 3): TransitionPage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 3 || pages.previous-page == 3;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    page-index: 3;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    SettingsPage {
                        bike-lock() => { root.bike-lock(); }
                        bike-lock-status: root.bike-lock-status;
                        can-configure: root.can-configure;
                        connect-peer(arg0) => { root.connect-peer(arg0); }
                        connect-wired() => { root.connect-wired(); }
                        connected: root.connected;
                        controller-status: root.controller-status;
                        discover-controller() => { root.discover-controller(); }
                        forget-peer() => { root.forget-peer(); }
                        integration-choice <=> root.integration-choice;
                        link-present: root.link-present;
                        lock-timeout: root.lock-timeout;
                        lock-timeout-changed(arg0) => { root.lock-timeout-changed(arg0); }
                        peers: root.peers;
                        pin-configured: root.pin-configured;
                        proxy-pairing-code: root.proxy-pairing-code;
                        pin-remove() => { root.pin-remove(); }
                        pin-setup() => { root.pin-setup(); }
                        screen-lock() => { root.screen-lock(); }
                        supports-lock: root.supports-lock;
                        metric: root.metric;
                        celsius: root.celsius;
                        rotation: root.rotation;
                        brightness: root.brightness;
                        footer-visibility: root.footer-visibility;
                        cycle-footer-visibility => {
                            root.footer-visibility = root.footer-visibility == FooterVisibility.show ? FooterVisibility.hide :
                                root.footer-visibility == FooterVisibility.hide ? FooterVisibility.auto : FooterVisibility.show;
                            root.preferences-changed();
                        }
                        transport-kind: root.transport-kind;
                        can-available: root.can-available;
                        uart-available: root.uart-available;
                        can-change-transport: root.can-change-transport;
                        select-transport(kind) => { root.transport-requested(kind); }
                        ble-proxy-enabled: root.ble-proxy-enabled;
                        ble-proxy-status: root.ble-proxy-status;
                        proxy-name: root.proxy-name;
                        proxy-name-locked: root.proxy-name-locked;
                        edit-proxy-name => { root.edit-proxy-name(); }
                        toggle-proxy => { root.ble-proxy-enabled = !root.ble-proxy-enabled; root.ble-proxy-changed(root.ble-proxy-enabled); }
                        toggle-units => { root.metric = !root.metric; root.preferences-changed(); }
                        toggle-temperature => { root.celsius = !root.celsius; root.preferences-changed(); }
                        rotate => { root.orientation-requested(root.rotation == 270 ? 0 : root.rotation + 90); }
                        dim => { root.brightness -= 10; root.preferences-changed(); }
                        brighten => { root.brightness += 10; root.preferences-changed(); }
                        wifi => { root.page = 4; root.wifi-scan(); }
                        updates => { root.page = 5; }
                        about => { root.page = 6; }
                    }
                }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 4 || pages.previous-page == 4): WifiPage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 4 || pages.previous-page == 4;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    network-busy: root.network-busy;
                    wifi-connect-saved() => { root.wifi-connect-saved(); }
                    wifi-forget() => { root.wifi-forget(); }
                    wifi-manual() => { root.wifi-manual(); }
                    wifi-networks: root.wifi-networks;
                    wifi-saved: root.wifi-saved;
                    wifi-scan() => { root.wifi-scan(); }
                    wifi-select(arg0) => { root.wifi-select(arg0); }
                    wifi-status: root.wifi-status;
                }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 5 || pages.previous-page == 5): UpdatesPage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 5 || pages.previous-page == 5;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    vesc-update-mode: root.vesc-update-mode;
                    vesc-update-active: root.vesc-update-active;
                    vesc-update-progress: root.vesc-update-progress;
                    vesc-update-status: root.vesc-update-status;
                    vesc-update-mode-requested(enabled) => { root.vesc-update-mode-requested(enabled); }
                    vesc-update-cancel => { root.vesc-update-cancel(); }
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    can-maintain: root.can-maintain;
                    firmware-version: root.firmware-version;
                    network-busy: root.network-busy;
                    ota-confirming <=> root.ota-confirming;
                    page <=> root.page;
                    reboot-ready: root.reboot-ready;
                    release-version: root.release-version;
                    update-available: root.update-available;
                    update-cancel() => { root.update-cancel(); }
                    update-check() => { root.update-check(); }
                    update-progress: root.update-progress;
                    update-reboot() => { root.update-reboot(); }
                    updating: root.updating;
                    wifi-connected: root.wifi-connected;
                    wifi-scan() => { root.wifi-scan(); }
                    wifi-status: root.wifi-status;
                }
                if root.show-page-content && (HardwareCapabilities.page-snapshots || pages.active-page == 6 || pages.previous-page == 6): AboutPage {
                    selected-page: !HardwareCapabilities.page-snapshots || pages.active-page == 6 || pages.previous-page == 6;
                    slide-width: pages.slide-width;
                    capture-page: HardwareCapabilities.page-snapshots ? root.native-capture-page : -1;
                    active-page: pages.active-page;
                    animating: pages.animating;
                    direction: pages.direction;
                    progress: pages.progress;
                    swiping: pages.swiping;
                    swipe-origin: pages.swipe-origin;
                    swipe-offset: pages.swipe-offset;
                    about-diagnostics <=> root.about-diagnostics;
                    about-items: root.about-items;
                    device-label: root.device-label;
                    firmware-version: root.firmware-version;
                    network-busy: root.network-busy;
                    page <=> root.page;
                    update-check() => { root.update-check(); }
                }
            }

            footer := AutoHideFooter {
                visibility-mode: root.footer-visibility;
                idle-allowed: root.page-input-allowed && !root.transitioning;
                animations-enabled: root.animations-enabled;
                gap: root.landscape ? 16px : root.compact ? 8px : 12px;
                page: root.page;
                page-requested(page) => { root.page = page; }
            }
        }
    }
    // Swallow presses/releases while either page is moving. Modal controls
    // remain above this blocker and retain their existing safety interlocks.
    if root.transitioning: TouchArea {
        clicked => {}
    }
    if root.tuning-editor-open && root.tuning-ready && !root.pin-open: TuningEditor {
        field: root.tuning-editor-index >= 0 && root.tuning-editor-index < root.tuning-fields.length ? root.tuning-fields[root.tuning-editor-index] : root.limit-editor-field;
        enabled: root.connected && root.tuning-ready && !root.tuning-busy;
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        adjust(delta) => {
            if root.tuning-editor-index == -2 {
                let next = clamp(root.limit-editor-field.position + delta, root.limit-editor-field.minimum, root.limit-editor-field.maximum);
                root.edit-limit-position(next);
            } else { root.tuning-adjust(root.tuning-fields[root.tuning-editor-index].id, delta); }
        }
        set-value(value) => {
            if root.tuning-editor-index == -2 { root.edit-limit-position(value); }
            else { root.tuning-set(root.tuning-fields[root.tuning-editor-index].id, value); }
        }
        closed => { root.tuning-editor-index = -1; }
    }
    if root.confirming: ApplyConfirmation {
        can-configure: root.can-configure;
        cancel-change() => { root.cancel-change(); }
        confirm-change() => { root.confirm-change(); }
        confirm-text: root.confirm-text;
        connected: root.connected;
        display-safe-inset-x: root.display-safe-inset-x;
        display-safe-inset-y: root.display-safe-inset-y;
    }
    if root.ota-confirming: UpdateConfirmation {
        can-maintain: root.can-maintain;
        display-safe-inset-x: root.display-safe-inset-x;
        display-safe-inset-y: root.display-safe-inset-y;
        network-busy: root.network-busy;
        ota-confirming <=> root.ota-confirming;
        update-install() => { root.update-install(); }
        wifi-connected: root.wifi-connected;
    }
    if root.editing: Keyboard {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        heading: root.editor-heading;
        value: root.editor-value;
        masked: root.editor-masked;
        secret: root.editor-secret;
        typed(value) => { root.editor-type(value); }
        backspace => { root.editor-backspace(); }
        done => { root.editor-done(); }
        cancel => { root.editor-cancel(); }
    }
    if root.update-modal-open: UpdateProgress {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        active: (root.updating && !root.reboot-ready) || root.vesc-update-active;
        ready: root.reboot-ready;
        cancellable: root.update-dialog-vesc ? root.vesc-update-cancellable : root.update-cancellable;
        can-restart: root.can-maintain && !root.network-busy;
        progress: root.update-dialog-vesc ? root.vesc-update-progress : root.reboot-ready ? 100 : root.update-progress;
        status: root.update-dialog-vesc ? root.vesc-update-status : root.wifi-status;
        source: root.update-dialog-vesc ? "VESC Tool | " + root.vesc-update-transport : "Wi-Fi OTA";
        cancel => { if root.update-dialog-vesc { root.vesc-update-cancel(); } else { root.update-cancel(); } }
        restart => { root.update-result-open = false; root.update-reboot(); }
        closed => { root.update-result-open = false; }
    }
    if root.pin-open: PinPad {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        heading: root.pin-heading;
        value: root.pin-value;
        pattern: root.pin-pattern;
        mode-requested(pattern) => { root.unlock-method-requested(pattern ? 1 : 0); }
        message: root.pin-message;
        ready: root.pin-ready;
        locked: root.screen-locked;
        retry-available: root.lock-retry-available;
        digit(value) => { root.pin-digit(value); }
        backspace => { root.pin-backspace(); }
        clear => { root.pin-clear(); }
        submit => { root.pin-submit(); }
        cancel => { root.pin-cancel(); }
        retry => { root.lock-retry(); }
    }
    if root.pairing-open && root.pairing-permitted: PinPad {
        safe-inset-x: root.display-safe-inset-x;
        safe-inset-y: root.display-safe-inset-y;
        heading: "BLUETOOTH PIN";
        value: root.pairing-value;
        pattern: false;
        allow-mode-change: false;
        auto-submit: false;
        min-digits: 1;
        message: root.pairing-failed ? "Pairing failed. Retry to enter the current Bluetooth PIN." : "Enter the numeric passkey configured on your VESC Express, then Submit.";
        ready: root.pairing-ready;
        show-keypad: !root.pairing-failed;
        locked: false;
        retry-available: root.pairing-failed;
        retry-label: "Retry pairing";
        digit(value) => { root.pairing-type(value); }
        backspace => { root.pairing-backspace(); }
        clear => { root.pairing-clear(); }
        submit => { root.pairing-submit(); }
        cancel => { root.pairing-cancel(); }
        retry => { root.pairing-retry(); }
    }
    if root.screen-asleep: Rectangle {
        background: #000;
        TouchArea { }
    }
}
