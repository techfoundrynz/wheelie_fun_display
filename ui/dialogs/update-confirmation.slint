import { Action } from "../controls.slint";
import { Theme } from "../theme.slint";
import { ModalFrame } from "modal-frame.slint";

export component UpdateConfirmation inherits ModalFrame {
    in property <bool> can-maintain;
    in property <length> display-safe-inset-x;
    in property <length> display-safe-inset-y;
    in property <bool> network-busy;
    in-out property <bool> ota-confirming;
    in property <bool> wifi-connected;

    callback update-install();

    safe-inset-x: root.display-safe-inset-x;
    safe-inset-y: root.display-safe-inset-y;
    VerticalLayout {
        padding: 0px;
        spacing: 12px;
        alignment: center;
        Text {
            text: "INSTALL UPDATE?";
            color: Theme.accent;
            font-size: 24px;
        }

        Text {
            text: "Bluetooth will disconnect during installation. Keep the display powered. Restart after verification to use the new firmware.";
            color: Theme.text;
            wrap: word-wrap;
            font-size: 16px;
        }

        Action {
            label: "Install now";
            enabled: root.can-maintain && root.wifi-connected && !root.network-busy;
            activated => { root.ota-confirming = false; root.update-install(); }
        }

        Action {
            label: "Cancel";
            activated => { root.ota-confirming = false; }
        }
    }
}
