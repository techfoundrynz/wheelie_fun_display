import { Theme } from "theme.slint";
// Shared vertically scrolling page. Body content retains its natural height,
// so touch targets remain usable on the 2.06-inch display in either orientation.
export component Page inherits Rectangle {
    in property <string> title;
    Flickable {
        content-width: self.width;
        content-height: content.min-height;
        content := VerticalLayout {
            padding-bottom: 12px;
            spacing: 12px;
            Text {
                text: root.title;
                color: Theme.accent;
                font-size: 20px;
                font-weight: 800;
            }

            @children
        }
    }
}
