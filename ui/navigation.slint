import { Action } from "controls.slint";

export component Navigation inherits HorizontalLayout {
    in property <int> page;
    callback page-requested(int);

    height: 50px;
    spacing: 6px;
    for label[i] in ["Ride", "Stats", "Tune"]: Action {
        label: label;
        selected: root.page == i;
        activated => { root.page-requested(i); }
    }
}
