import { Theme } from "theme.slint";
import { Action } from "controls.slint";

export component SectionTitle inherits Text {
    color: Theme.secondary;
    font-size: 14px;
    font-weight: 700;
}

export component SettingsRow inherits Rectangle {
    accessible-role: button;
    accessible-label: root.label;
    in property <string> label;
    in property <string> detail;
    in property <bool> enabled: true;
    callback activated();
    min-height: 60px;
    background: touch.pressed ? Theme.raised : Theme.surface;
    border-radius: 12px;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        Text {
            text: root.label;
            color: root.enabled ? Theme.text : Theme.dim;
            font-size: 18px;
            vertical-alignment: center;
        }

        Text {
            text: root.detail;
            color: Theme.secondary;
            font-size: 16px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            width: 18px;
            Image {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                source: @image-url("assets/chevron-right.svg");
                colorize: root.enabled ? Theme.secondary : Theme.dim;
                image-fit: contain;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

export component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> can-decrease: true;
    in property <bool> can-increase: true;
    callback decrease();
    callback increase();
    min-height: 72px;
    background: Theme.surface;
    border-radius: 12px;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Action {
            label: "-";
            width: 44px;
            enabled: root.can-decrease;
            activated => { root.decrease(); }
        }

        VerticalLayout {
            Text {
                text: root.label;
                color: Theme.secondary;
                font-size: 14px;
                horizontal-alignment: center;
            }

            Text {
                text: root.value;
                color: Theme.text;
                font-size: 18px;
                horizontal-alignment: center;
            }
        }

        Action {
            label: "+";
            width: 44px;
            enabled: root.can-increase;
            activated => { root.increase(); }
        }
    }
}

export component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    min-height: 56px;
    background: Theme.surface;
    border-radius: 8px;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.secondary;
            font-size: 14px;
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-size: 16px;
            wrap: word-wrap;
        }
    }
}
