import { TransitionPage } from "../page-transition.slint";
import { RideTelemetry } from "ride/model.slint";
import { PortraitRide } from "ride/portrait.slint";
import { LandscapeRide } from "ride/landscape.slint";
import { WideRide } from "ride/wide.slint";

export component RidePage inherits TransitionPage {
    page-index: 0;
    in property <string> battery;
    in property <float> battery-level;
    in property <bool> compact;
    in property <bool> fresh;
    in property <bool> hot;
    in property <bool> landscape;
    in property <bool> metric;
    in property <string> mosfet;
    in property <string> motor;
    in property <string> pitch;
    in property <string> power;
    in property <bool> short-landscape;
    in property <string> speed;
    in property <float> speed-progress;
    in property <string> voltage;
    in property <string> trip;
    in property <string> odometer;

    // Use available logical space, so layout selection follows all four rotations.
    private property <bool> wide: root.landscape && root.width >= 640px && root.height >= 260px;
    private property <bool> tall: !root.landscape && root.width >= 400px && root.height >= 560px;
    private property <RideTelemetry> telemetry: {
        battery: root.battery,
        battery-level: root.battery-level,
        fresh: root.fresh,
        hot: root.hot,
        metric: root.metric,
        mosfet: root.mosfet,
        motor: root.motor,
        pitch: root.pitch,
        power: root.power,
        speed: root.speed,
        speed-progress: root.speed-progress,
        voltage: root.voltage,
        trip: root.trip,
        odometer: root.odometer,
    };

    if !root.landscape: PortraitRide {
        data: root.telemetry;
        compact: root.compact;
        expanded: root.tall;
    }
    if root.landscape && !root.wide: LandscapeRide {
        data: root.telemetry;
        short-landscape: root.short-landscape;
    }
    if root.wide: WideRide {
        data: root.telemetry;
    }
}
